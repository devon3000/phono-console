[Unit]
Description=Phono Console Bluetooth A2DP ingest
Wants=bluetooth.service bluealsa.service sound.target
After=bluetooth.service bluealsa.service sound.target

[Service]
Type=simple
User=phono-console
Group=phono-console
SupplementaryGroups=audio bluetooth
ExecStart=/opt/phono-console/current/bin/bluetooth-ingest
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
RestrictSUIDSGID=true
LockPersonality=true
RestrictAddressFamilies=AF_UNIX

[Install]
WantedBy=multi-user.target
